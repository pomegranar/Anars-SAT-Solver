/target
**/*.rs.bk

# Reference solvers: sources + built binaries, fetched by scripts/fetch_tools.sh
/tools/

# Benchmark instances: ~7.5k files, fetched by scripts/fetch_benchmarks.sh
/benchmarks/_dl/
/benchmarks/suites/

# Benchmark output
/results/*.csv
/results/*.json
/benchmarks/clean/
/benchmarks/generated/

# splr writes an answer file per solve into its working directory
ans_*.cnf

# Generated report artefacts
/results/report.pdf
/results/_report/
/results/*.log

# Paper: figures/tables are regenerated from results/*.csv by scripts/academic_plots.py;
# the PDF and latexmk's auxiliary files are build output, not source.
/paper/figures/
/paper/tables/
/paper/paper.pdf
/paper/*.aux
/paper/*.log
/paper/*.out
/paper/*.fls
/paper/*.fdb_latexmk
/paper/*.bbl
/paper/*.blg
